{
  "name": "graspt",
  "version": "0.2.0",
  "description": "Allocentric topological proof navigation for Lean 4 + Mathlib \u2014 npm CLI launching a localhost website. Read-only exploration; Lean-verified ghost previews only.",
  "license": "MIT",
  "author": "Graspt contributors",
  "homepage": "https://github.com/automathing/graspt",
  "repository": {
    "type": "git",
    "url": "https://github.com/automathing/graspt.git"
  },
  "keywords": [
    "lean4",
    "mathlib",
    "theorem-proving",
    "proof-navigation",
    "topological-slam"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "bin": {
    "graspt": "dist/apps/cli/graspt.js"
  },
  "files": [
    "dist/apps",
    "dist/packages",
    "apps/web",
    "fixtures/demo"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "start": "npm run build && node dist/apps/cli/graspt.js",
    "build:web": "vite build --config apps/web/vite.config.mts",
    "dev:web": "vite --config apps/web/vite.config.mts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.5.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@radix-ui/react-slot": "^1.5.0",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
