{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/cli/**/*.ts", "apps/server/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules", "apps/web"]
}
