{
  "name": "Graspt — Lean 4 + Mathlib + pi (Meta Muse)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.elan/bin:${containerEnv:PATH}",
    "GRASPT_PI_MODEL": "meta/muse-spark-1.3"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4"
      ],
      "settings": {
        "graspt.agentProvider": "pi",
        "graspt.piUseMetaMuse": true,
        "graspt.piMetaModel": "meta/muse-spark-1.3",
        "graspt.defaultCoarseLevel": "L2",
        "graspt.parallelBranches": 3,
        "editor.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
        "files.exclude": {
          "**/.lake": true,
          "**/.graspt/worktrees": true
        }
      }
    },
    "codespaces": {
      "openFiles": [
        "lean/Demo/LocalLayout.lean",
        "lean/Demo/Basics.lean",
        "README.md"
      ]
    }
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/setup.sh --link-only"
}
